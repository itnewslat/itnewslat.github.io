---
layout: null
published: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>https://itnews.lat/</link>
    <atom:link href="https://itnews.lat/feed.xml" rel="self" type="application/rss+xml"/>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {% for post in site.posts limit:25 %}
      {% assign big_image = post.social-image | default: post.detail-image | default: post.image %}
      {% if post.social_caption and post.social_caption != "" %}
        {% assign short_desc = post.social_caption %}
      {% elsif post.takeaways and post.takeaways.size > 0 %}
        {% capture short_desc %}📌 {{ post.title }}

• {{ post.takeaways | join: "
• " }}{% if post.mentions and post.mentions != "" %}

🏢 {{ post.mentions }}{% endif %}

📲 @itnewslat @erinconm
🔗 https://itnews.lat{{ post.url }}{% endcapture %}
      {% else %}
        {% assign clean_excerpt = post.content | strip_html | replace: 'Resumen Ejecutivo ITNEWS', '' | normalize_whitespace | truncate: 320 %}
        {% capture short_desc %}📌 {{ post.title }}

{{ clean_excerpt }}{% if post.mentions and post.mentions != "" %}

🏢 {{ post.mentions }}{% endif %}

📲 @itnewslat @erinconm
🔗 https://itnews.lat{{ post.url }}{% endcapture %}
      {% endif %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ short_desc | strip | xml_escape }}</description>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        <link>https://itnews.lat{{ post.url }}</link>
        <guid isPermaLink="true">https://itnews.lat{{ post.url }}</guid>
        <enclosure url="{{ big_image | strip | xml_escape }}" type="image/jpeg" length="150000" />
        <media:thumbnail url="{{ big_image | strip | xml_escape }}" width="1024" height="680" />
        <media:content medium="image" url="{{ big_image | strip | xml_escape }}" type="image/jpeg" width="1024" height="680" />
        {% for tag in post.tags %}
        <category>{{ tag | xml_escape }}</category>
        {% endfor %}
        {% for cat in post.categories %}
        <category>{{ cat | xml_escape }}</category>
        {% endfor %}
        <superNews>{{ post.superNews }}</superNews>
      </item>
    {% endfor %}
  </channel>
</rss>
