---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title"      : {{ post.title | jsonify }},
      "categories" : {{ post.categories | jsonify }},
      "tags"       : "{{ post.tags | join: ', ' }}",
      "url"        : "{{ site.baseurl }}{{ post.url }}",
      "date"       : "{{ post.date | date: '%Y-%m-%d' }}",
      "year"       : "{{ post.date | date: '%Y' }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
